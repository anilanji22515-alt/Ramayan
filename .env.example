# CampusCare Prototype Environment Configuration

APP_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Central Parent / Guardian Notification Email (Specification Mandatory)
PARENT_NOTIFICATION_EMAIL=anilanji22515@gmail.com

# SMTP Delivery Configuration
# When EMAIL_ENABLED is true and credentials are provided, live emails are sent.
# Otherwise, emails are safely logged to the outbox database table in simulation mode.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-email@college.edu
SMTP_PASSWORD=your-smtp-app-password
EMAIL_FROM=campuscare-noreply@college.edu

# Storage & Regional Settings
DATABASE_PATH=campuscare.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
CAMPUS_NAME=College of Engineering & Technology
TIMEZONE=Asia/Kolkata
